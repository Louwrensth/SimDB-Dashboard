# save this template as /etc/nginx/templates/*.template and
# envsubst will substitute ${SOMETHING} from environment at nginx startup


# Special value PUBLIC_SIMDB_HOST="DASHBOARD_HOST" (default set in docker compose) enables the app to send
# simdb api requests to the backend via nginx proxy at location dashboard_host:dashboard_port/api
# Otherwise, use it as the literal host of the simdb backend. e.g. PUBLIC_SIMDB_HOST=simdb.iter.org
map "${PUBLIC_SIMDB_HOST}" $public_dashboard_host {
    "DASHBOARD_HOST"    $host;
    default             "${PUBLIC_SIMDB_HOST}";
}
server {
    listen 8080;
    # listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;
    absolute_redirect off;
    resolver 127.0.0.11 valid=30s;

    # dashboard app expects request url path to start with /dashboard/
    location = /            { return 302 /dashboard/; }
    location = /dashboard   { return 302 /dashboard/; }
    location /dashboard/ {
        try_files $uri $uri/ /dashboard/index.html;
    }

    # location proxies for simdb backend
    # accepted prefixes, stripped:
    #   (?:(?:scenarios/?)?(?:api/?)?)?
    #   scenarios/, scenarios/api/, api/, or without /, or no prefix
    # accepted paths, captured in "$app" (:
    #   (?<app>v1(?:\.(?:0|1|2))?|swaggerui)?
    #   v1, v1.0, v1.1, v1.2, swaggerui, or none
    # any remaining path, captured in "$rest":
    #   (?<rest>/.*)?
    # # if suffix equals ",debug" (before ?query=) show the constructed proxy target
    # location ~ ^/(?:(?:scenarios/?)?(?:api/?)?)?(?<app>v1(?:\.(?:0|1|2))?|swaggerui)?(?<rest>/.*)?,debug$ {
    #     return 200 "proxy_pass http://${API_HOST}:${API_PORT}/$app$rest$is_args$args;\n";
    # }
    location ~ ^/(?:(?:scenarios/?)?(?:api/?)?)?(?<app>v1(?:\.(?:0|1|2))?|swaggerui)?(?<rest>/.*)?$ {
        include proxy_params;
        proxy_pass http://${API_HOST}:${API_PORT}/$app$rest$is_args$args;
    }

    # dashboard is a simdb client;
    # runtime-config.js defines the simdb remote url to use.
    # runtime-config-template.js
    location = /dashboard/runtime-config.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files /runtime-config-template.js =404;
        sub_filter_once off;
        sub_filter_types application/javascript;
        # Optional tokens to replace in template:
        sub_filter 'SCHEME' '$scheme';
        sub_filter 'PUBLIC_SIMDB_HOST' '$public_dashboard_host';
        sub_filter 'DASHBOARD_PORT' '${DASHBOARD_PORT}';
        sub_filter 'API_HOST' '${API_HOST}';
        sub_filter 'API_PORT' '${API_PORT}';
    }
}
