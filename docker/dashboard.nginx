# save this template as /etc/nginx/templates/*.template and
# envsubst will substitute ${SOMETHING} from environment at nginx startup


# Temporary variable $public_dashboard_host used to capture env ${PUBLIC_SIMDB_HOST}.
# If it set to special value "DASHBOARD_HOST" (default in compose), then it is replaced with $host
# (i.e. the host in the client's http request) which is the external IP of this container
# Otherwise: allow override to a particular SimDB host, e.g. PUBLIC_SIMDB_HOST=simdb.iter.org
map "${PUBLIC_SIMDB_HOST}" $public_dashboard_host {
    "DASHBOARD_HOST"    $host;
    default             "${PUBLIC_SIMDB_HOST}";
}


# FYI:
# 1. Docker's host.docker.internal IP is injected in /etc/hosts
#    (compose using extra_hosts: "host.docker.internal:host-gateway") 
#    but this is *not* available when resolving via Docker's internal DNS.
# 2. Nginx may also avoid reading /etc/hosts (like nslookup and dig),
#    which happens when nginx treats a directive as dynamic.
# 3. We have variables in the proxy_pass uri ($app and $rest), thus making it dynamic,
#    and host.docker.internal will not be resolved to the IP in /etc/hosts.
# Workaround:
# Hostnames inside upstream blocks are resolved at config-load time using the
# system resolver, which does read /etc/hosts.
upstream simdb_backend {
    server ${API_HOST}:${API_PORT};
}

server {
    listen 80;
    # listen [::]:80;
    server_name _;
    root /usr/share/nginx/html;
    absolute_redirect off;

    # dashboard app expects request url path to start with /dashboard/
    location = /            { return 302 /dashboard/; }
    location = /dashboard   { return 302 /dashboard/; }
    location /dashboard/ {
        try_files $uri $uri/ /dashboard/index.html;
    }

    # location proxies for simdb backend
    # accepted prefixes, stripped:
    #   (?:(?:scenarios/?)?(?:api/?)?)?
    #   scenarios/, scenarios/api/, api/, or without /, or no prefix
    # accepted paths, captured in "$app" (:
    #   (?<app>v1(?:\.(?:0|1|2))?|swaggerui)?
    #   v1, v1.0, v1.1, v1.2, swaggerui, or none
    # any remaining path, captured in "$rest":
    #   (?<rest>/.*)?
    # # if suffix equals ",debug" (before ?query=) show the constructed proxy target
    # location ~ ^/(?:(?:scenarios/?)?(?:api/?)?)?(?<app>v1(?:\.(?:0|1|2))?|swaggerui)?(?<rest>/.*)?,debug$ {
    #     return 200 "proxy_pass http://simdb_backend/$app$rest$is_args$args;\n";
    # }
    location ~ ^/(?:(?:scenarios/?)?(?:api/?)?)?(?<app>v1(?:\.(?:0|1|2))?|swaggerui)?(?<rest>/.*)?$ {
        include proxy_params;
        proxy_pass http://simdb_backend/$app$rest$is_args$args;
    }

    # dashboard is a simdb client;
    # runtime-config.js defines the simdb remote url to use.
    # runtime-config-template.js
    location = /dashboard/runtime-config.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files /runtime-config-template.js =404;
        sub_filter_once off;
        sub_filter_types application/javascript;
        # Optional tokens to replace in template:
        sub_filter 'SCHEME' '$scheme';
        sub_filter 'PUBLIC_SIMDB_HOST' '$public_dashboard_host';
        sub_filter 'DASHBOARD_PORT' '${DASHBOARD_PORT}';
        sub_filter 'API_HOST' '${API_HOST}';
        sub_filter 'API_PORT' '${API_PORT}';
    }
}
