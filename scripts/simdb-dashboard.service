# SimDB Dashboard — systemd service unit
#
# Runs the SimDB Dashboard via docker compose under systemd.
#
# ## Quick start (HTTP)
#
# See `make systemd-install` and `make systemd-enable`.
#
#   1. Populate the working directory:
#
#      sudo mkdir -p /opt/simdb-dashboard
#      sudo cp docker-compose.yml /opt/simdb-dashboard/
#      sudo cp docker-compose.systemd.yml /opt/simdb-dashboard/
#      sudo cp -r docker/nginx/templates /opt/simdb-dashboard/
#
#   2. Create the environment file (only what differs from defaults):
#
#      sudo mkdir -p /etc/simdb-dashboard
#      sudo tee /etc/simdb-dashboard/simdb-dashboard.env <<EOF
#      API_HOST=host.docker.internal
#      SIMDB_SERVER_URL=/scenarios/api
#      EOF
#
#   3. Install and start:
#
#      sudo cp simdb-dashboard.service /etc/systemd/system/
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now simdb-dashboard
#
# ## Quick start (HTTPS)
#
#   Follow the HTTP steps above, but additionally copy the HTTPS override
#   and update COMPOSE_FILE to include it before the systemd override:
#
#      sudo cp docker-compose.https.yml /opt/simdb-dashboard/
#
#      sudo mkdir -p /etc/ssl/simdb-dashboard
#      sudo cp docker/nginx/ssl/cert.* /etc/ssl/simdb-dashboard/
#      sudo mkdir -p /opt/simdb-dashboard/docker/nginx
#      sudo ln -sf /etc/ssl/simdb-dashboard /opt/simdb-dashboard/docker/nginx/ssl
#
#      # Update the env file
#      sudo tee /etc/simdb-dashboard/simdb-dashboard.env <<EOF
#      COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml:docker-compose.systemd.yml
#      DASHBOARD_PORT=80
#      API_PORT=5000
#      API_HOST=host.docker.internal
#      SIMDB_SERVER_URL=/scenarios/api
#      EOF
#
# ## Environment reference
#
# Variables in /etc/simdb-dashboard/simdb-dashboard.env are passed through
# to docker compose and override defaults in the compose files.
#
#   Variable             Default                        Description
#   ─────────────────────────────────────────────────────────────────
#   COMPOSE_FILE         (required)                     Compose file stack (see quick-start above)
#   SIMDB_DASHBOARD_TAG  service-0.9.0-68-g8819049     GHCR image tag (from docker-compose.systemd.yml)
#   DASHBOARD_PORT       80                             Published host port for HTTP
#   DASHBOARD_HTTPS_PORT 443                            Published host port for HTTPS
#   API_HOST             host.docker.internal           SimDB backend hostname
#   API_PORT             5000                           SimDB backend port
#   SIMDB_SERVER_URL     /scenarios/api                 Browser-side API base path
#
# ## See also
#
#   docs/installation.md                  — full build and deployment guide
#   scripts/generate-self-signed-certs.sh — helper for test certificates

[Unit]
Description=SimDB Dashboard — containerized Vue.js frontend and nginx reverse proxy
Documentation=https://github.com/iterorganization/SimDB-Dashboard
Requires=docker.service
After=docker.service network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes

# --- paths ------------------------------------------------------------
EnvironmentFile=/etc/simdb-dashboard/simdb-dashboard.env
WorkingDirectory=/opt/simdb-dashboard

# --- defaults (overridden by env file when set) -----------------------
Environment="COMPOSE_FILE=docker-compose.yml:docker-compose.systemd.yml"
Environment="DASHBOARD_CONTAINER_NAME=simdb-dashboard-systemd"
Environment="SIMDB_DASHBOARD_TAG=service-0.9.0-68-g8819049"
#Environment="SIMDB_DASHBOARD_IMAGE="
Environment="DASHBOARD_PORT=80"
Environment="DASHBOARD_HTTPS_PORT=443"
Environment="API_HOST=host.docker.internal"
Environment="API_PORT=5000"
Environment="SIMDB_SERVER_URL=/scenarios/api"

# --- lifecycle --------------------------------------------------------
ExecStartPre=-/usr/bin/docker compose pull --ignore-pull-failures
ExecStart=/usr/bin/docker compose up --detach --remove-orphans
ExecStop=/usr/bin/docker compose down

# --- restart behaviour ------------------------------------------------
Restart=on-failure
RestartSec=10s

# --- stop timeout -----------------------------------------------------
TimeoutStopSec=30

# --- security hardening -----------------------------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=~CAP_SYS_ADMIN CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

# --- logging ----------------------------------------------------------
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
